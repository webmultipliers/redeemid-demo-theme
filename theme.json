{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "color": "#fbfaf7", "name": "Base" },
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "contrast", "color": "#1c1f23", "name": "Contrast" },
				{ "slug": "muted", "color": "#5c6670", "name": "Muted" },
				{ "slug": "line", "color": "#e3e0d8", "name": "Line" },
				{ "slug": "accent", "color": "#00775a", "name": "Accent" },
				{ "slug": "accent-soft", "color": "#e3f1ec", "name": "Accent soft" },
				{ "slug": "warning-soft", "color": "#fdf3dc", "name": "Warning soft" },
				{ "slug": "ink", "color": "#8a1c1c", "name": "Ink red" },
				{ "slug": "harbor", "color": "#102a3c", "name": "Harbor navy" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, Georgia, serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.375rem", "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "name": "Extra large", "fluid": { "min": "1.6rem", "max": "2.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "XS" },
				{ "slug": "30", "size": "1rem", "name": "S" },
				{ "slug": "40", "size": "1.5rem", "name": "M" },
				{ "slug": "50", "size": "2.5rem", "name": "L" },
				{ "slug": "60", "size": "4rem", "name": "XL" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.01em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": { "radius": "8px" },
				"spacing": {
					"padding": { "top": "0.55rem", "bottom": "0.55rem", "left": "1rem", "right": "1rem" }
				},
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }
			}
		},
		"blocks": {
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
